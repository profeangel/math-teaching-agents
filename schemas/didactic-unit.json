{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-teaching-agents.org/schemas/didactic-unit.json",
  "title": "DidacticUnitSpecification",
  "description": "Contrato semántico universal para unidades didácticas, secuencias de clase e ingeniería de situaciones matemáticas.",
  "type": "object",
  "required": [
    "metadata",
    "theoretical_alignment",
    "epistemological_diagnostics",
    "phases"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["unit_title", "target_grade", "topic", "estimated_sessions"],
      "properties": {
        "unit_title": { "type": "string" },
        "target_grade": { "type": "string" },
        "topic": { "type": "string" },
        "estimated_sessions": { "type": "integer", "minimum": 1 },
        "minutes_per_session": { "type": "integer", "default": 90 },
        "curriculum_expectation_ref": { "type": "string" }
      }
    },
    "theoretical_alignment": {
      "type": "object",
      "required": ["active_frameworks"],
      "properties": {
        "active_frameworks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Identificadores de perfiles en frameworks/ (ej. ['brousseau-tsd', 'duval-trrs'])"
        },
        "networking_justification": { 
          "type": "string",
          "description": "Justificación metodológica de la articulación teórica (Radford / Bikner-Ahsbahs)" 
        }
      }
    },
    "epistemological_diagnostics": {
      "type": "object",
      "description": "Insumos provenientes de mtsk-kflm sobre barreras cognitivas",
      "required": ["target_misconceptions", "prerequisites_required"],
      "properties": {
        "target_misconceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "description", "confrontation_strategy"],
            "properties": {
              "code": { "type": "string" },
              "description": { "type": "string" },
              "confrontation_strategy": { "type": "string" }
            }
          }
        },
        "prerequisites_required": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "phase_name",
          "cognitive_demand",
          "teacher_role",
          "student_activity"
        ],
        "properties": {
          "phase_id": { "type": "integer" },
          "phase_name": { "type": "string" },
          "cognitive_demand": {
            "type": "string",
            "enum": ["MEMORIZACION", "PROCEDIMIENTOS_SIN_CONEXIONES", "PROCEDIMIENTOS_CON_CONEXIONES", "HACIENDO_MATEMATICA"]
          },
          "example_choice_rationale": {
            "type": "string",
            "description": "Justificación de los valores numéricos o figuras seleccionadas (Rowland et al.)"
          },
          "teacher_role": { "type": "string", "description": "Acción mediadora sin desvolatilizar la tarea (Chevallard / Danielson)" },
          "student_activity": { "type": "string", "description": "Consigna y acción del estudiante" },
          "udl_guidelines": {
            "type": "object",
            "properties": {
              "representation": { "type": "string" },
              "action_expression": { "type": "string" },
              "engagement": { "type": "string" }
            }
          },
          "dynamic_artifact_ref": {
            "type": "string",
            "description": "Identificador opcional de applet GeoGebra, Desmos o widget web asociado"
          }
        }
      }
    }
  }
}
